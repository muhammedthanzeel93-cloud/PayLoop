# ==============================================================================
# Kerala Tourism Ecosystem — Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (server)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Safe MongoDB URI (Local or MongoDB Atlas)
MONGO_URL=mongodb://127.0.0.1:27017/kerala_tourism
# Backward compatible alias
MONGODB_URI=mongodb://127.0.0.1:27017/kerala_tourism

# Primary Frontend Client URL
CLIENT_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Backward compatible alias
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ------------------------------------------------------------------------------
# Frontend Applications Configuration (apps/web, apps/admin, apps/business)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Mobile Application Configuration (apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
